# 排程（Asia/Taipei 時區）
SYNC_EMPLOYEES_CRON=30 0 5 * *
SYNC_LINE_UID_CRON=0 1 * * *
SYNC_APPOINTED_UNITS_CRON=0 4 * * *
SYNC_APPOINTED_UNIT_MEMBERS_CRON=0 */2 * * *
