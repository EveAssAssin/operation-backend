# ============================================================
# 營運部系統 Backend 環境變數
# 複製此檔為 .env 並填入實際值
# ============================================================

# 基本設定
PORT=3001
NODE_ENV=development

# Supabase（營運部專用 Project）
SUPABASE_URL=https://your-operation-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 左手系統 API（人員同步用，與市場系統共用）
LEFTHAND_API_URL=https://map.lohasglasses.com/_api/v1.ashx
LEFTHAND_AES_KEY=GmAOoS003d5OJ2G2
LEFTHAND_AES_IV=bgfDcfWdWG6NSUr5

# 工單系統 API（LINE UID 同步用）
WORKORDER_API_URL=https://ticket.ruki-ai.com/api/v1/employee

# LINE 推播（與市場系統共用同一隻 BOT）
LINEBOT_PUSH_URL=https://ticket.ruki-ai.com/api/external/notify
LINEBOT_API_KEY=lohas-notify-2026-secret

# 市場部任務系統（任務派發模組用）
MARKET_BACKEND_URL=https://market-backend-0544.onrender.com
MARKET_INTERNAL_KEY=<2026-ject-2026>

# 前端 URL（CORS + 簽收 QR Code 連結）
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# LINE LIFF ID（營運部專用，需在 LINE Developers 建立）
LINE_LIFF_ID=

# ============================================================
# 特約廠商模組 — 樂活搜點子 (lohas.realtime.tw) webapi
# ============================================================
LOHAS_WEBAPI_URL=https://lohas.realtime.tw/webapi/v010
LOHAS_WEBAPI_TEST_URL=https://lohastest.realtime.tw/webapi/v010
LOHAS_WEBAPI_KEY=bfjY2jssj9dDajq0
LOHAS_WEBAPI_KEY_TEST=ch856m30xangih8r
LOHAS_WEBAPI_VER=0.1.0
LOHAS_WEBAPI_USE_TEST=false

# ============================================================
# 特約廠商模組 — 新 LINE OA（與營運部任務 Bot 不同隻）
# ============================================================
APPOINTED_UNIT_LINE_CHANNEL_ID=
APPOINTED_UNIT_LINE_CHANNEL_SECRET=
APPOINTED_UNIT_LINE_ACCESS_TOKEN=
